# Carrera Configuration
# Copy this to .env and fill in your values

# Application
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///./data/carrera.db

# Email Notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Scraper settings
REQUEST_TIMEOUT=30
REQUEST_DELAY_MIN=1.0
REQUEST_DELAY_MAX=3.0
MAX_JOBS_PER_RUN=100

# Scheduler (cron expressions)
SCRAPE_SCHEDULE=0 8,18 * * *   # 8am and 6pm daily

# AI provider settings (all optional — template fallback works with zero keys)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# PDF output
PDF_OUTPUT_DIR=./data/pdfs

# Optional partner APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
